{
  "name": "dynamic-mapper",
  "version": "6.4.3",
  "author": "christof.strack@cumulocity.com, stefan.witschel@cumulocity.com",
  "description": "Cumulocity Dynamic Mapper UI to map data from any data source to Cumulocity and vice-versa in a zero-code/low-code way. When using an AI Provider code and mappings can be generated.",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "prestart": "node scripts/optimize-images.js",
    "prebuild": "node scripts/optimize-images.js",
    "build": "ng build",
    "prewatch": "node scripts/optimize-images.js",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "format": "prettier --write 'src/**/*.ts'",
    "lint": "eslint \"cypress/**/*.ts\"",
    "e2e:open": "env -u ELECTRON_RUN_AS_NODE cypress open",
    "e2e:run": "env -u ELECTRON_RUN_AS_NODE cypress run"
  },
  "license": "Apache-2.0",
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@ai-sdk/anthropic": "^1.2.12",
    "@ai-sdk/openai": "^1.3.24",
    "@angular/animations": "21.2.19",
    "@angular/cdk": "^21.0.0",
    "@angular/common": "21.2.19",
    "@angular/compiler": "21.2.19",
    "@angular/core": "21.2.19",
    "@angular/forms": "21.2.19",
    "@angular/platform-browser": "21.2.19",
    "@angular/router": "21.2.19",
    "@c8y/bootstrap": "1024.14.0",
    "@c8y/client": "1024.14.0",
    "@c8y/ngx-components": "1024.14.0",
    "@c8y/style": "1024.14.0",
    "ai": "^4.3.19",
    "echarts": "^5.6.0",
    "highlight.js": "^11.11.1",
    "jsonata": "^2.1.0",
    "marked": "^18.0.9",
    "monaco-editor": "^0.53.0",
    "ngx-bootstrap": "21.0.1",
    "ngx-echarts": "^18.0.0",
    "rxjs": "7.8.2",
    "tslib": "^2.3.0",
    "vanilla-jsoneditor": "^3.13.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/architect": "^0.2102.19",
    "@angular/build": "^21.2.19",
    "@angular/cli": "^21.2.19",
    "@angular/compiler-cli": "21.2.19",
    "@c8y/devkit": "1024.14.0",
    "@c8y/options": "1024.14.0",
    "@types/file-saver": "^2.0.7",
    "@types/jasmine": "~5.1.0",
    "@types/lodash": "^4.17.24",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "cumulocity-cypress": "^1.4.1",
    "cypress": "14.5.4",
    "cypress-slow-down": "^1.3.1",
    "dotenv": "^16.6.1",
    "eslint-plugin-cypress": "^6.4.1",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "less": "^4.2.0",
    "sharp": "^0.35.3",
    "typescript": "~5.9.2",
    "webpack": "^5.105.0"
  }
}
