      "valid": false,
      "error": "MappingTopic_And_MappingTopicSample_Do_Not_Have_Same_Number_Of_Levels_In_Topic_Name",
      "why": "without # the count must match exactly"
    },
    {
      "topic": "a/b/#",
      "sample": "a",
      "valid": false,
      "error": "MappingTopic_And_MappingTopicSample_Do_Not_Have_Same_Number_Of_Levels_In_Topic_Name",
      "why": "sample shorter than the fixed part"
    },
    {
      "topic": "/a/b",
      "sample": "a/b",
      "valid": false,
      "error": "MappingTopic_And_MappingTopicSample_Do_Not_Have_Same_Number_Of_Levels_In_Topic_Name",
      "why": "the leading slash is a level"
    },
    {
      "topic": "A/b",
      "sample": "a/b",
      "valid": false,
