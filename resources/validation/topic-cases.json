{
  "_comment": "Shared by the backend (MappingValidatorSharedCasesTest) and the UI (topic-validation-cases.spec.ts). Add a case here and both validators must agree. 'error' is an error code the result must contain.",
  "inbound": [
    {
      "topic": "plant1/+/+",
      "sample": "plant1/line2/m7",
      "valid": true,
      "why": "+ matches one level each"
    },
