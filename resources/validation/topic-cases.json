      "topic": "device/+",
      "sample": "device/110",
      "valid": true
    },
    {
      "topic": "a/#",
      "sample": "a/x/y/z",
      "valid": true,
      "why": "trailing # matches any number of further levels"
    },
    {
      "topic": "a/#",
      "sample": "a",
      "valid": true,
      "why": "# also matches zero levels"
    },
    {
      "topic": "a/b/c",
      "sample": "a/b/c/",
      "valid": true,
      "why": "a trailing slash is ignored"
    },
    {
