    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "One row per (tenant, direction, transformation type) with at least one mapping currently cached. Counts are live — always reflect the current mapping cache, not a point-in-time snapshot. Legacy transformation types (DEFAULT, SUBSTITUTION_AS_CODE) are deprecated; expect them to taper to zero.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] },
          "unit": "short"
