        "overrides": []
      },
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 7 },
      "id": 14,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
