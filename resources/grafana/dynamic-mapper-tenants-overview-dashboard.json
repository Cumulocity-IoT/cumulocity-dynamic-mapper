          "instant": true,
          "range": false,
          "legendFormat": "__auto",
          "refId": "C"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "count by (tenant) (dynmapper_connector_status)",
          "instant": true,
          "range": false,
          "legendFormat": "__auto",
          "refId": "D"
        }
