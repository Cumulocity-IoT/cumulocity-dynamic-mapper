            { "type": "value", "options": { "1": { "text": "CONFIGURED", "color": "blue", "index": 1 } } },
            { "type": "value", "options": { "2": { "text": "ENABLED", "color": "blue", "index": 2 } } },
            { "type": "value", "options": { "3": { "text": "CONNECTING", "color": "yellow", "index": 3 } } },
            { "type": "value", "options": { "4": { "text": "CONNECTED", "color": "green", "index": 4 } } },
            { "type": "value", "options": { "5": { "text": "DISCONNECTED", "color": "red", "index": 5 } } },
            { "type": "value", "options": { "6": { "text": "DISCONNECTING", "color": "orange", "index": 6 } } },
            { "type": "value", "options": { "7": { "text": "FAILED", "color": "red", "index": 7 } } },
            { "type": "value", "options": { "8": { "text": "RETRYING", "color": "orange", "index": 8 } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] },
          "unit": "short"
