      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 24 },
      "id": 51,
      "options": {
        "cellHeight": "sm",
        "showHeader": true,
        "sortBy": [{ "displayName": "Tenant", "desc": false }]
      },
      "pluginVersion": "11.0.0",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum by (tenant, direction, transformationType) (dynmapper_mapping_count) > 0",
          "instant": true,
          "range": false,
          "legendFormat": "__auto",
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "__name__": true, "application": true, "instance": true },
            "renameByName": {
              "tenant": "Tenant",
              "direction": "Direction",
              "transformationType": "Transformation Type",
              "Value": "# Mappings"
            }
          }
        }
      ],
      "title": "Mapping Counts by Tenant, Direction & Transformation Type",
      "type": "table"
    },
