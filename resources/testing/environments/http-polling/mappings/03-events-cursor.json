  "targetTemplate": "{\"type\":\"c8y_PollEvent\",\"text\":\"Synthetic poll event #1\",\"time\":\"2026-09-22T10:01:00.000Z\",\"source\":{\"id\":\"909090\"}}",
  "substitutions": [
