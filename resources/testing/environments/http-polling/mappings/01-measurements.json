{
  "identifier": "httppoll-meas",
  "name": "HTTP Polling - Measurements",
  "mappingTopic": "measurements",
  "mappingTopicSample": "measurements",
  "targetAPI": "MEASUREMENT",
  "direction": "INBOUND",
  "mappingType": "JSON",
  "transformationType": "JSONATA",
  "sourceTemplate": "{\"deviceId\":\"poll-sensor-01\",\"timestamp\":\"2026-09-22T10:00:00.000Z\",\"temperature\":23.47}",
  "targetTemplate": "{\"c8y_TemperatureMeasurement\":{\"T\":{\"value\":23.47,\"unit\":\"C\"}},\"time\":\"2026-09-22T10:00:00.000Z\",\"type\":\"c8y_TemperatureMeasurement\",\"source\":{\"id\":\"909090\"}}",
  "substitutions": [
    {
      "pathSource": "deviceId",
      "pathTarget": "_IDENTITY_.externalId",
      "repairStrategy": "DEFAULT",
      "expandArray": false
    },
    {
      "pathSource": "timestamp",
      "pathTarget": "time",
      "repairStrategy": "DEFAULT",
      "expandArray": false
    },
    {
      "pathSource": "temperature",
      "pathTarget": "c8y_TemperatureMeasurement.T.value",
      "repairStrategy": "DEFAULT",
      "expandArray": false
    }
  ],
  "active": false,
  "debug": false,
  "createNonExistingDevice": true,
  "updateExistingDevice": false,
  "autoAckOperation": true,
  "useExternalId": true,
  "externalIdType": "c8y_Serial",
  "qos": "AT_LEAST_ONCE",
  "genericDeviceIdentifier": "_IDENTITY_.externalId"
}
