{
  "apiVersion": "2",
  "version": "0.0.1-SNAPSHOT",
  "name": "my-processor",
  "contextPath": "my-processor",
  "provider": {
    "name": "Dynamic Mapper Test"
  },
  "buildSpec": {
    "targetBuildArchitectures": [
      "linux/amd64"
    ]
  },
  "isolation": "PER_TENANT",
  "resources": {
    "cpu": "0.1",
    "memory": "256M"
  },
  "requiredRoles": [],
  "livenessProbe": {
    "httpGet": {
      "path": "/health"
    },
    "initialDelaySeconds": 30,
    "periodSeconds": 10
  },
  "readinessProbe": {
    "httpGet": {
      "path": "/health",
      "port": 80
    },
    "initialDelaySeconds": 30,
    "periodSeconds": 10
  }
}
