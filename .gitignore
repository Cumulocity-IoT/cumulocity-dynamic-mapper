# Key material and keystores. Pattern-based on purpose: these previously used exact
# paths, and a folder rename silently disarmed them, leaving a private key untracked
# but stageable by `git add -A`. Nothing matching these is tracked today.
*.key
*.pem
*.jks
*.p12
*.pfx
*.keystore
*.truststore

# Scratch output written by the integration tests (x509 certs, upload markers).
tmp/

