<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!--
  Build-time source rules, run by maven-checkstyle-plugin in the validate phase.
  Kept deliberately small: add a rule here only when the codebase already complies.
-->
<module name="Checker">
    <property name="severity" value="error"/>
    <property name="fileExtensions" value="java"/>
    <module name="TreeWalker">
        <!-- Explicit imports only, static imports included (no "import x.y.*;"). -->
        <module name="AvoidStarImport"/>
    </module>
</module>
